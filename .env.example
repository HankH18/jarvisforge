# Jarvis — environment variables (copy to .env and fill in real values)
#
# Model IDs come from CONVO_MODEL / TOOL_MODEL ONLY — never hardcode a model
# id anywhere in source.
#
# THIS FILE IS FOR LOCAL DEVELOPMENT ONLY. .env is gitignored and is never
# copied into the image or uploaded to Fly. Deployment credentials live in two
# other places, and neither of them belongs here:
#
#   1. Your Fly login — how *you* talk to Fly, not something the app ever reads.
#      `fly auth login` stores it in ~/.fly/config.yml. In CI, export
#      FLY_API_TOKEN instead. There is deliberately no FLY_* entry below.
#
#   2. The deployed app's runtime secrets — set on Fly, not in a file:
#          fly secrets set ANTHROPIC_API_KEY=... LIVEKIT_API_KEY=...
#      Fly injects them as env vars inside the container. fly.toml's header
#      lists exactly which ones the app needs.
#
#   DATABASE_URL below points at the local docker-compose Postgres. In
#   production it is injected automatically by `fly postgres attach` — do not
#   set it by hand there.

# --- LiveKit (real-time voice transport) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=changeme
LIVEKIT_API_SECRET=changeme

# --- Speech-to-text ---
DEEPGRAM_API_KEY=changeme

# --- Text-to-speech ---
# TTS_PROVIDER selects the voice backend; "cartesia" is the default, with
# "aura2" (Deepgram Aura-2) as the documented fallback.
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=changeme

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=changeme
CONVO_MODEL=claude-haiku-4-5
TOOL_MODEL=claude-sonnet-5

# --- Database (Postgres + pgvector, for mem0 + the preferences table) ---
# Must match backend/docker-compose.yml. The host port is 55432, NOT 5432:
# 5432 is commonly already bound by an unrelated local Postgres, and pointing
# at it would silently read/write the wrong database instead of failing loudly.
DATABASE_URL=postgresql://jarvis:jarvis_dev_local_only@localhost:55432/jarvis

# --- GitHub ---
# Read-only for repo Q&A; a scoped write token is only needed for the T-11
# agentic issue -> PR bot.
GITHUB_TOKEN=changeme

# --- Clerk (auth) ---
CLERK_SECRET_KEY=changeme
CLERK_PUBLISHABLE_KEY=changeme
VITE_CLERK_PUBLISHABLE_KEY=changeme
