# Jarvis — environment variables (copy to .env and fill in real values)
#
# Model IDs come from CONVO_MODEL / TOOL_MODEL ONLY — never hardcode a model
# id anywhere in source.
#
# THIS FILE IS FOR LOCAL DEVELOPMENT ONLY. .env is gitignored and is never
# copied into the image or uploaded to Fly. Deployment credentials live in two
# other places, and neither of them belongs here:
#
#   1. Your Fly login — how *you* talk to Fly, not something the app ever reads.
#      `fly auth login` stores it in ~/.fly/config.yml. In CI, export
#      FLY_API_TOKEN instead. There is deliberately no FLY_* entry below.
#
#   2. The deployed app's runtime secrets — set on Fly, not in a file:
#          fly secrets set ANTHROPIC_API_KEY=... LIVEKIT_API_KEY=...
#      Fly injects them as env vars inside the container. fly.toml's header
#      lists exactly which ones the app needs.
#
#   DATABASE_URL below points at the local docker-compose Postgres. In
#   production it is injected automatically by `fly postgres attach` — do not
#   set it by hand there.

# --- LiveKit (real-time voice transport) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=changeme
LIVEKIT_API_SECRET=changeme

# JARVIS_ROOM_SALT (optional): dedicated secret authenticated-mode /api/token
# uses to derive each user's private LiveKit room name, independent of
# LIVEKIT_API_SECRET. If unset, the room derivation falls back to
# LIVEKIT_API_SECRET (the original behavior, kept for upgrade compatibility).
# Rotating THIS value changes every user's room name (in-flight sessions are
# stranded) -- only rotate it on purpose (e.g. it leaked). Once it is set,
# rotating LIVEKIT_API_SECRET on its own (routine credential hygiene, or a
# forced rotation because it leaked) no longer renames anyone's room. See
# jarvis.server.app._room_for_authenticated_identity's docstring.
JARVIS_ROOM_SALT=changeme

# --- Speech-to-text ---
DEEPGRAM_API_KEY=changeme

# --- Text-to-speech ---
# TTS_PROVIDER selects the voice backend; "cartesia" is the default, with
# "aura2" (Deepgram Aura-2) as the documented fallback.
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=changeme

# CARTESIA_TTS_MODEL (optional): pins/overrides the Cartesia TTS model id.
# build_tts() always passes model= explicitly now -- defaulting to
# "sonic-3", the CURRENT installed-plugin default -- so a future
# livekit-plugins-cartesia bump can no longer silently move this project
# onto a different model with zero visibility in this repo's diff. This is
# for REPRODUCIBILITY, not cost: Cartesia publishes no per-model credit
# rates, and billing is by seconds of generated audio (not model choice),
# so do not change this on a guess that a different model is "cheaper".
# Valid values (installed plugin's models.py): sonic, sonic-2, sonic-lite,
# sonic-preview, sonic-turbo, sonic-3.
CARTESIA_TTS_MODEL=sonic-3

# JARVIS_PREEMPTIVE_TTS (optional, default unset/off): opt back into
# starting TTS synthesis before a turn is officially confirmed (the SDK's
# own default is LLM-only preemptive generation; this also preempts TTS --
# see worker.py's module docstring). Off by default after a 2026-08-15
# incident where it contributed to draining a 20,000-credit/month free
# Cartesia tier in ~13 minutes: Cartesia bills by SECONDS OF GENERATED
# AUDIO, and preemptive TTS re-synthesizes on every not-yet-final STT
# transcript revision, discarding (but still paying for) whatever gets
# cancelled. It IS a genuine R1 (<800ms p95 time-to-first-audio) latency
# lever, so it stays explorable via this var rather than deleted outright;
# set to 1 to A/B it. When set, the SDK's speculative-retry cap (default 3)
# is also lowered to 1 in code, so the opted-in path can cost at most 1
# discarded + 1 real synthesis per turn instead of up to 3 discarded + 1
# real.
JARVIS_PREEMPTIVE_TTS=

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=changeme
CONVO_MODEL=claude-haiku-4-5
TOOL_MODEL=claude-sonnet-5

# --- Database (Postgres + pgvector, for mem0 + the preferences table) ---
# Must match backend/docker-compose.yml. The host port is 55432, NOT 5432:
# 5432 is commonly already bound by an unrelated local Postgres, and pointing
# at it would silently read/write the wrong database instead of failing loudly.
DATABASE_URL=postgresql://jarvis:jarvis_dev_local_only@localhost:55432/jarvis

# --- GitHub ---
# Read-only for repo Q&A; a scoped write token is only needed for the T-11
# agentic issue -> PR bot.
GITHUB_TOKEN=changeme

# --- Clerk (auth) ---
CLERK_SECRET_KEY=changeme
CLERK_PUBLISHABLE_KEY=changeme
VITE_CLERK_PUBLISHABLE_KEY=changeme

# --- Test/measurement script spend guard (2026-08-15) ---
# ALLOW_CARTESIA_SPEND: scripts/drive_turns.py and scripts/load_smoke.sh
# both refuse to run at all unless this is set to 1 -- a
# `drive_turns.py --turns 55` run against the deployed worker exhausted a
# 20,000-credit/month free Cartesia tier in ~13 minutes (Cartesia bills by
# SECONDS OF GENERATED AUDIO, roughly 12 credits/second, not characters;
# see .claude/NEEDS_HUMAN.md's "ANSWERED -- where the free Cartesia credits
# went" for the full writeup). NEITHER script can actually force what TTS
# provider the worker it drives uses -- drive_turns.py talks to a SEPARATE
# process (locally, or the DEPLOYED Fly worker via --token-url) whose own
# $TTS_PROVIDER (set on Fly, not here) decides that; load_smoke.sh never
# sends audio at all, but the real deployed worker still auto-joins every
# room it opens on the same LiveKit project. This var is therefore an
# explicit, informed-opt-in confirmation, not a provider switch -- both
# scripts print what to check/set on the actual target (typically
# `fly secrets set TTS_PROVIDER=aura2 -a jarvisforge`) every time they run.
# Leave unset for the safe default (refuse to run).
ALLOW_CARTESIA_SPEND=
